# Copy this to .env and fill in real values for local development.

# Postgres connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/midnight_bsh?schema=public"

# Session cookie encryption key (32+ chars). Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-plus-character-string"

# Night window (the app only accepts new posts/votes/certificate claims
# during this window each day). Times are hours-of-day, 0-23, in TIMEZONE.
NIGHT_START_HOUR="21"
NIGHT_END_HOUR="9"
TIMEZONE="Europe/Paris"

# Shared secret required by the nightly rollover cron endpoint
# (POST/GET /api/cron/nightly-rollover with `Authorization: Bearer <secret>`
# or a `?secret=` query param). Vercel Cron Jobs read this automatically
# from the CRON_SECRET env var and attach the Authorization header for you.
CRON_SECRET="change-me-too"

# Chain the SIWE wallet sign-in message is scoped to (1 = Ethereum mainnet).
NEXT_PUBLIC_CHAIN_ID="1"
